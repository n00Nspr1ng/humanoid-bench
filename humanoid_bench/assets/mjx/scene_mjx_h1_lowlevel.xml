<mujoco model="h1 lowlevel scene">
  <!--
    Scene XML for H1 lowlevel locomotion training (Brax/MJX).

    Includes the original robot definition unchanged, then adds:
      - Ground plane
      - IMU sensors (gyro, upvector, local/global linvel, global angvel)
      - Foot site linear velocity sensors (for feet_slip reward)
      - Foot site force sensors (for feet_force/contact_force reward)
      - Home keyframe (knees-bent standing pose)

    NOTE: Leg-crossing termination is implemented in Python by comparing
    left_foot / right_foot site y-positions (left_foot_y < right_foot_y
    means legs have crossed), avoiding the need to name the anonymous
    collision geoms in the included robot XML.

    Touch sensors left_foot_sensor / right_foot_sensor (from the included
    robot XML) serve as the floor-contact indicator for feet_air_time and
    feet_slip rewards (reading > 0.5 N = foot in contact).
  -->

  <include file="h1_mjx_feet_collisions_pos_lowlevel.xml"/>

  <statistic center="0 0 1" extent="1.8" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="160" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.9 0.9 0.9" rgb2="0.8 0.8 0.8" markrgb="0.2 0.2 0.2"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane"
      contype="1" conaffinity="0"/>
  </worldbody>

  <sensor>
    <!-- IMU sensors (attached to imu site on torso_link) -->
    <gyro site="imu" name="gyro"/>
    <velocimeter site="imu" name="local_linvel_torso"/>
    <framezaxis objtype="site" objname="imu" name="upvector_torso"/>
    <framelinvel objtype="site" objname="imu" name="global_linvel_torso"/>
    <frameangvel objtype="site" objname="imu" name="global_angvel_torso"/>

    <!-- Foot linear velocity sensors (for feet_slip reward) -->
    <framelinvel objtype="site" objname="left_foot" name="left_foot_global_linvel"/>
    <framelinvel objtype="site" objname="right_foot" name="right_foot_global_linvel"/>

    <!-- Foot force sensors (for feet_force / contact_force reward) -->
    <!-- Reads the 3D resultant force applied at the foot site (z = normal GRF) -->
    <force name="left_foot_force" site="left_foot"/>
    <force name="right_foot_force" site="right_foot"/>
  </sensor>

  <!--
    Home keyframe: knees-bent standing pose.
    Joint order (qpos[7:]):
      left_hip_yaw, left_hip_roll, left_hip_pitch, left_knee, left_ankle,
      right_hip_yaw, right_hip_roll, right_hip_pitch, right_knee, right_ankle,
      torso,
      left_shoulder_pitch, left_shoulder_roll, left_shoulder_yaw, left_elbow,
      right_shoulder_pitch, right_shoulder_roll, right_shoulder_yaw, right_elbow
  -->
  <keyframe>
    <key name="home"
      qpos="
        0 0 0.98
        1 0 0 0
        0 0 -0.4 0.8 -0.4
        0 0 -0.4 0.8 -0.4
        0
        0  0.3 0 0.8
        0 -0.3 0 0.8"
      ctrl="
        0 0 -0.4 0.8 -0.4
        0 0 -0.4 0.8 -0.4
        0
        0  0.3 0 0.8
        0 -0.3 0 0.8"/>
  </keyframe>

</mujoco>
